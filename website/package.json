{
  "name": "maplespire-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "qa:visual": "node scripts/visual-qa.cjs",
    "media:render-frames": "node scripts/render-story-frames.cjs",
    "media:select-boundaries": "node scripts/select-story-boundaries.mjs",
    "test:quality": "node scripts/verify-image-quality.mjs media.quality.json artifacts/quality",
    "pretest": "astro build",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:components": "vitest run",
    "test:media": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "astro": "7.3.6",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
