---
import '../styles/global.css';
import '../styles/legal.css';
import '../styles/article.css';
import '../styles/rtl.css';
import { REPOSITORY_URL, localeOptions } from '../lib/content';
import { articleLocales } from '../lib/articles';
import type { ArticleDocument, ArticleLocale, ArticleSlug } from '../lib/articles';
import { legalCopy } from '../lib/legal';
import { serializeJsonLd } from '../lib/jsonLd';
import { tourVideoFor, videoObject, videoPosterPath } from '../lib/video';
import TourVideo from '../components/TourVideo';
import ArticleText from '../components/ArticleText.astro';

interface Props {
  locale: ArticleLocale;
  slug: ArticleSlug;
  document: ArticleDocument;
  appUrl: string;
  /** What the article is about besides MapleSpire itself (schema.org nodes). */
  about?: Array<Record<string, string>>;
}

const { locale, slug, document, appUrl, about = [] } = Astro.props;
const labels = legalCopy[locale];
const localeMeta = localeOptions.find((option) => option.locale === locale) ?? localeOptions[0];
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin);
const pathFor = (target: string) => `/${target}/${slug}/`;
const canonical = new URL(pathFor(locale), siteUrl);
// An article with a video shares its poster (PNG, like the video thumbnail); the others the site card.
const video = document.video ? tourVideoFor(locale, document.video.set) : null;
const ogImage = new URL(
  video ? videoPosterPath(video, 'png') : locale === 'fr' ? '/social/maplespire-og-fr.png' : '/social/maplespire-og.png',
  siteUrl,
);
const alternates = articleLocales.map((target) => localeOptions.find((option) => option.locale === target)!);
const homeUrl = new URL(`/${locale}/`, siteUrl);
const citations = document.sections.flatMap((section) => section.links ?? []).map((link) => link.url);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${canonical.href}#article`,
      url: canonical.href,
      mainEntityOfPage: canonical.href,
      headline: document.title,
      description: document.description,
      inLanguage: localeMeta.htmlLang,
      datePublished: document.isoDate,
      dateModified: document.isoDate,
      image: ogImage.href,
      author: { '@id': `${siteUrl.href}#organization` },
      publisher: { '@id': `${siteUrl.href}#organization` },
      isPartOf: { '@id': `${siteUrl.href}#website` },
      about: [{ '@id': `${siteUrl.href}#software` }, ...about],
      ...(citations.length ? { citation: citations } : {}),
      ...(video ? { video: { '@id': `${canonical.href}#video` } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'MapleSpire', item: homeUrl.href },
        { '@type': 'ListItem', position: 2, name: document.seoTitle, item: canonical.href },
      ],
    },
    ...(video
      ? [{ ...videoObject(video, siteUrl.href, canonical.href), publisher: { '@id': `${siteUrl.href}#organization` } }]
      : []),
  ],
};
---

<!doctype html>
<html lang={localeMeta.htmlLang} dir={localeMeta.dir} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={document.description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#f2efe9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141516" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {alternates.map((option) => (
      <link rel="alternate" hreflang={option.htmlLang} href={new URL(pathFor(option.locale), siteUrl)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en'), siteUrl)} />
    <link rel="icon" href="/brand/maplespire-mark.svg" type="image/svg+xml" />
    <title>{document.seoTitle}</title>
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={document.isoDate} />
    <meta property="article:modified_time" content={document.isoDate} />
    <meta property="og:site_name" content="MapleSpire" />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    <meta property="og:title" content={document.seoTitle} />
    <meta property="og:description" content={document.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={document.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={document.seoTitle} />
    <meta name="twitter:description" content={document.description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('maplespire:theme');
          const theme = saved === 'dark' || saved === 'light'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch (_) {}
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />
  </head>
  <body class="legal-body">
    <a class="legal-skip" href="#article-content">{document.skipLabel}</a>
    <header class="legal-header">
      <a class="legal-brand" href={`/${locale}/`} aria-label={`MapleSpire · ${labels.home}`}>
        <span>
          <img class="mark-light" src="/brand/maplespire-mark.svg" alt="" width="28" height="34" />
          <img class="mark-dark" src="/brand/maplespire-mark-dark.svg" alt="" width="28" height="34" />
        </span>
        <b>MapleSpire</b>
      </a>
      <nav aria-label={labels.languageLabel}>
        <a href={`/${locale}/`}>{document.backLabel}</a>
        <details>
          <summary>{localeMeta.code}</summary>
          <div>
            {alternates.map((option) => (
              <a
                href={pathFor(option.locale)}
                hreflang={option.htmlLang}
                lang={option.htmlLang}
                aria-current={option.locale === locale ? 'page' : undefined}
              >
                <span>{option.code}</span>{option.name}
              </a>
            ))}
          </div>
        </details>
      </nav>
    </header>

    <main id="article-content" class="legal-main">
      <aside class="legal-index" aria-label={document.contentsLabel}>
        <p>{document.contentsLabel}</p>
        {document.video && <a href={`#${document.video.id}`}>{document.video.title}</a>}
        {document.sections.map((section) => (
          <a href={`#${section.id}`}>{section.title}</a>
        ))}
      </aside>

      <article class="legal-article article-body">
        <header class="legal-hero">
          <p>{document.eyebrow}</p>
          <h1>{document.title}</h1>
          <div class="legal-meta">
            <span>{document.updatedLabel} <time datetime={document.isoDate}>{document.updatedDate}</time></span>
          </div>
          <p class="legal-summary">{document.summary}</p>
          <p class="legal-important">{document.verdict}</p>
        </header>

        {document.video && (
          <section class="article-video" id={document.video.id} aria-labelledby={`${document.video.id}-title`}>
            <h2 id={`${document.video.id}-title`}>{document.video.title}</h2>
            <p><ArticleText text={document.video.body} /></p>
            <TourVideo
              client:visible
              locale={locale}
              set={document.video.set}
              copy={{
                play: document.video.play,
                watchOnYoutube: document.video.watchOnYoutube,
                otherLanguage: document.video.otherLanguage,
                captionsNote: document.video.captionsNote,
              }}
              embedded
            />
          </section>
        )}

        <div class="legal-sections">
          {document.sections.map((section) => (
            <section id={section.id}>
              <h2>{section.title}</h2>
              {section.lead && <p><ArticleText text={section.lead} /></p>}
              {section.table && (
                <div class="article-table-wrap">
                  <table class="article-table">
                    <caption>{section.table.caption}</caption>
                    <thead>
                      <tr>{section.table.columns.map((column) => <th scope="col">{column}</th>)}</tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map(([label, first, second]) => (
                        <tr>
                          <th scope="row"><ArticleText text={label} /></th>
                          <td><ArticleText text={first} /></td>
                          <td><ArticleText text={second} /></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.paragraphs?.map((paragraph) => <p><ArticleText text={paragraph} /></p>)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li><ArticleText text={bullet} /></li>)}
                </ul>
              )}
              {section.links && (
                <ul class="article-sources">
                  {section.links.map((link) => (
                    <li><a href={link.url} target="_blank" rel="noreferrer">{link.label}</a></li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>

        <aside class="article-cta">
          <h2>{document.ctaTitle}</h2>
          <p>{document.ctaBody}</p>
          <div>
            <a class="article-button article-button-primary" href={appUrl}>{document.ctaPrimary} ↗</a>
            <a class="article-button" href={REPOSITORY_URL} target="_blank" rel="noreferrer">{document.ctaSecondary} ↗</a>
          </div>
        </aside>
      </article>
    </main>

    <footer class="legal-footer">
      <span>© 2026 MapleSpire contributors</span>
      <nav>
        <a href={`/${locale}/`}>{labels.home}</a>
        <a href={REPOSITORY_URL} target="_blank" rel="noreferrer">GitHub</a>
        <a href={`/${locale}/termsofservice/`}>{labels.terms}</a>
        <a href={`/${locale}/privacystatement/`}>{labels.privacy}</a>
      </nav>
    </footer>
  </body>
</html>
