---
import { localeOptions } from '../lib/content';

interface Props {
  targetPath: string;
  title: string;
  description: string;
  legalKind?: 'termsofservice' | 'privacystatement';
}

const { targetPath, title, description, legalKind } = Astro.props;
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin);
const canonical = new URL(targetPath, siteUrl);
const localizedPath = (locale: string) => legalKind
  ? `/${locale}/${legalKind}/`
  : `/${locale}/`;
---

<!doctype html>
<html lang="en-CA" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <link rel="canonical" href={canonical} />
    {localeOptions.map((option) => (
      <link rel="alternate" hreflang={option.htmlLang} href={new URL(localizedPath(option.locale), siteUrl)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/brand/maplespire-mark.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline define:vars={{ targetPath }}>
      window.location.replace(targetPath + window.location.search + window.location.hash);
    </script>
  </head>
  <body>
    <main>
      <img src="/brand/maplespire-mark.svg" alt="" width="48" height="48" />
      <h1>MapleSpire</h1>
      <p>{description}</p>
      <a href={targetPath}>Continue in English</a>
    </main>
    <style>
      :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; color: #24272f; background: #f2efe9; }
      main { width: min(620px, calc(100% - 32px)); padding: clamp(30px, 6vw, 64px); box-sizing: border-box; border: 1px solid #d1cbc1; border-radius: 32px; background: #faf8f4; }
      h1 { margin: 24px 0 10px; font-size: clamp(38px, 7vw, 68px); line-height: .98; letter-spacing: -.055em; }
      p { color: #68635d; font-size: 18px; line-height: 1.6; }
      a { display: inline-flex; margin-top: 20px; padding: 14px 18px; border-radius: 999px; color: white; background: #24272f; font-weight: 700; text-decoration: none; }
      @media (prefers-color-scheme: dark) { body { color: #f5f1ea; background: #111213; } main { border-color: #393a3c; background: #191a1c; } p { color: #bdb8b1; } }
    </style>
  </body>
</html>
