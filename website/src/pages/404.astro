---
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={new URL('/404.html', siteUrl)} />
    <link rel="icon" href="/brand/maplespire-mark.svg" type="image/svg+xml" />
    <title>Page not found · MapleSpire</title>
  </head>
  <body>
    <main>
      <p>404</p>
      <h1>This page does not exist.</h1>
      <p>The MapleSpire landing page is available in six languages.</p>
      <nav aria-label="Available languages">
        <a href="/en/">English</a>
        <a href="/fr/">Français</a>
        <a href="/zh/">简体中文</a>
        <a href="/ja/">日本語</a>
        <a href="/ko/">한국어</a>
        <a href="/hi/">हिन्दी</a>
      </nav>
    </main>
    <style>
      :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; color: #24272f; background: #f2efe9; }
      main { width: min(680px, calc(100% - 32px)); padding: clamp(30px, 6vw, 64px); box-sizing: border-box; }
      h1 { margin: 8px 0 18px; font-size: clamp(42px, 8vw, 76px); line-height: 1; letter-spacing: -.055em; }
      nav { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
      a { padding: 12px 16px; border: 1px solid currentColor; border-radius: 999px; color: inherit; text-decoration: none; }
      @media (prefers-color-scheme: dark) { body { color: #f5f1ea; background: #111213; } }
    </style>
  </body>
</html>
